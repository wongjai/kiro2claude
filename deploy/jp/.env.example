# cp .env.example .env 之后填好，.env 已被 .gitignore 排除。
#
# 下游（new-api）调用本网关时用的 key。schema 只要求非空、没有长度下限，
# 所以自己保证强度：openssl rand -hex 32
KIRO2CLAUDE_API_KEY=

# ---- IAM Identity Center 自动 bootstrap ----------------------------------
# 设了 START_URL，容器启动时如果 kiro-cli 还没登录，就自己 spawn
# `kiro-cli login --use-device-flow`，把 device flow URL 打进日志，并在登录
# 成功后自动跑 `kiro-cli profile` 写入 profileArn（/kiro/usage 需要它）。
# 已登录时这条路径是幂等的：whoami 通过 → 只重跑一次 profile 激活。
#
# 留在这里而不是写进 docker-compose.yml：start URL 含 IdC 目录 ID，
# compose 是要进 git 的。
KIRO2CLAUDE_LOGIN_START_URL=https://d-xxxxxxxxxx.awsapps.com/start

# 留空则回退到 compose 里的 KIRO2CLAUDE_REGION。
KIRO2CLAUDE_LOGIN_REGION=us-east-1

# device flow 的整体超时，默认 600000（10 分钟）。超时 = 启动失败退出，
# 由 restart 策略重来一轮 —— 所以第一次 `up -d` 要盯着日志。
# KIRO2CLAUDE_LOGIN_TIMEOUT_MS=600000
